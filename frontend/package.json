    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^1.0.3",
    "deepmerge": "^4.2.2",
    "eslint": "^9.33.0",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-vue": "^7.8.0",
    "lint-staged": "^10.5.4",
    "node-factory": "^0.4.1",
    "prettier": "^2.2.1",
    "sass": "^1.32.8",
    "sass-loader": "^11.0.0",

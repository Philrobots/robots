    "vue-class-component": "^7.2.3",
    "vue-i18n": "^8.24.2",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.5.1",
    "vue-socket.io-extended": "^4.1.0",
    "vuetify": "^2.4.9",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^5.15.3",
